{
	"name": "rubhub",
	"version": "0.1.0",
	"license": "EUPL-1.2",
	"module": "frontend/app/app.tsx",
	"scripts": {
		"build": "rm -rf ./dist && NODE_ENV=production vite build",
		"check": "tsc --noEmit --project ./frontend/tsconfig.json",
		"dev": "rm -rf ./dist && NODE_ENV=development vite build --watch",
		"format": "npx @biomejs/biome check --write",
		"format:unsafe": "npx @biomejs/biome check --write --unsafe",
		"test": "npm run check && npm run test:e2e",
		"test:e2e": "npm run build && playwright test",
		"test:e2e:ui": "npm run build && playwright test --ui"
	},
	"husky": {
		"hooks": {
			"pre-commit": "npm run format"
		}
	},
	"dependencies": {
		"@types/prismjs": "^1.26.5",
		"lucide-svg": "^1.1.0",
		"prismjs": "^1.30.0"
	},
	"devDependencies": {
		"@playwright/test": "^1.57.0",
		"@biomejs/biome": "^2.3.8",
		"typescript": "^6.0",
		"vite": "^8.0.10"
	}
}
