{
	"name": "rubhub",
	"version": "0.1.0",
	"license": "EUPL-1.2",
	"module": "frontend/app/app.tsx",
	"scripts": {
		"build": "rm -rf ./dist && NODE_ENV=production vite build",
		"check": "tsc --project ./frontend/app/tsconfig.json",
		"dev": "rm -rf ./dist && NODE_ENV=development vite build --watch",
		"format": "npx @biomejs/biome check --write",
		"format:unsafe": "npx @biomejs/biome check --write --unsafe",
		"test": "echo \"No tests defined yet\""
	},
	"husky": {
		"hooks": {
			"pre-commit": "npm run format"
		}
	},
	"dependencies": {
		"@types/prismjs": "^1.26.5",
		"prismjs": "^1.30.0",
		"uuid": "^13.0.0",
		"zod": "^4.1.13"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.3.8",
		"@types/node": "^24.9.0",
		"typescript": "^5.9.3",
		"vite": "^7.3.0"
	}
}
